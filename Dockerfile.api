FROM python:3.12-slim
# RUN useradd -m runner: creates a non-root Linux user (UID 1000, matching the
# host's `tony` user) so files the container writes to bind mounts aren't root-owned.
RUN useradd -m runner
# WORKDIR /app: sets the container's working directory for all following instructions.
WORKDIR /app
# COPY packages ./packages: copies the sizer_engine package into the image.
COPY packages ./packages
# COPY apps ./apps: copies the FastAPI app (apps/api/sizer_api) into the image.
COPY apps ./apps
# RUN pip install ...: installs the API's two runtime dependencies (fastapi, uvicorn) —
# previously missing entirely, so the image had no server to run.
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.27"
# ENV PYTHONPATH=...: makes the engine and api packages importable without installing them,
# mirroring how the repo's own README runs them locally.
ENV PYTHONPATH=/app/packages/sizer_engine:/app/apps/api
# EXPOSE 8000: documents the port uvicorn listens on inside the container.
EXPOSE 8000
# USER runner: drops root privileges for the container's runtime process.
USER runner
# CMD [...]: the default command — starts the FastAPI app with uvicorn on all interfaces.
CMD ["python", "-m", "uvicorn", "sizer_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
